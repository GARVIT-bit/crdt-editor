{
  "name": "@crdt-editor/bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "crdt": "node --expose-gc --import tsx src/crdt.bench.ts",
    "server": "node --expose-gc --import tsx src/server.bench.ts",
    "all": "npm run crdt && npm run server",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crdt-editor/crdt": "*",
    "@crdt-editor/protocol": "*"
  },
  "devDependencies": {
    "@crdt-editor/server": "*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yjs": "13.6.33"
  }
}
